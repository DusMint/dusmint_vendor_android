{
  "expo": {
    "name": "Dusmint Partner",
    "slug": "dusmint-vendor",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dusmint-vendor",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "package": "com.dusmint.vendor",
      "googleServicesFile": "./google-services.json",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "DusMint Partner needs photo access to upload your shopfront picture.",
          "cameraPermission": "DusMint Partner needs camera access to take a picture of your store."
        }
      ]
    ]
  }
}
